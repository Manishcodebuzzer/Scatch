<%- include('./partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <div class="pb-6 border-b border-zinc-200 mb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-600 block mb-1">
            Atelier Dispatch
        </span>
        <h1 class="luxury-serif text-3xl font-extrabold text-zinc-900 tracking-tight">
            Checkout & Delivery Details
        </h1>
    </div>

    <form action="/order/place" method="POST" class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left Column: Shipping Address & Payment Form -->
        <div class="lg:col-span-7 space-y-8">
            
            <!-- Shipping Information -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200 shadow-sm space-y-6">
                <div class="flex items-center gap-2 border-b border-zinc-100 pb-3">
                    <i class="ri-map-pin-2-line text-lg text-amber-600"></i>
                    <h2 class="text-base font-bold text-zinc-900">1. Destination & Recipient</h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-700 mb-1">Full Name</label>
                        <input 
                            type="text" 
                            name="fullname" 
                            required 
                            value="<%= user.fullname || '' %>"
                            class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                        >
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-700 mb-1">Contact Phone</label>
                        <input 
                            type="tel" 
                            name="phone" 
                            required 
                            placeholder="+91 98765 43210"
                            value="<%= user.contact || '' %>"
                            class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                        >
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-zinc-700 mb-1">Street Address, Suite / Apartment</label>
                        <input 
                            type="text" 
                            name="street" 
                            required 
                            placeholder="e.g. Penthouse 4B, Signature Villa, Bandra West"
                            value="<%= user.address && user.address.street ? user.address.street : '' %>"
                            class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                        >
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-700 mb-1">City</label>
                        <input 
                            type="text" 
                            name="city" 
                            required 
                            placeholder="e.g. Mumbai"
                            value="<%= user.address && user.address.city ? user.address.city : '' %>"
                            class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                        >
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 mb-1">State</label>
                            <input 
                                type="text" 
                                name="state" 
                                required 
                                placeholder="e.g. Maharashtra"
                                value="<%= user.address && user.address.state ? user.address.state : '' %>"
                                class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                            >
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 mb-1">Pincode</label>
                            <input 
                                type="text" 
                                name="pincode" 
                                required 
                                placeholder="400050"
                                value="<%= user.address && user.address.pincode ? user.address.pincode : '' %>"
                                class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                            >
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Method Selection -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200 shadow-sm space-y-6">
                <div class="flex items-center gap-2 border-b border-zinc-100 pb-3">
                    <i class="ri-secure-payment-line text-lg text-amber-600"></i>
                    <h2 class="text-base font-bold text-zinc-900">2. Payment Method</h2>
                </div>

                <div class="space-y-3">
                    <!-- Cash on Delivery Option -->
                    <label class="flex items-center justify-between p-4 rounded-2xl border-2 border-zinc-900 bg-zinc-50 cursor-pointer transition-all">
                        <div class="flex items-center gap-3">
                            <input type="radio" name="paymentMethod" value="Cash on Delivery" checked class="w-4 h-4 text-black focus:ring-0">
                            <div>
                                <p class="text-xs font-bold text-zinc-900">Cash on Delivery (COD)</p>
                                <p class="text-[11px] text-zinc-500">Pay securely in cash or card upon atelier doorstep delivery</p>
                            </div>
                        </div>
                        <i class="ri-hand-coin-line text-xl text-zinc-800"></i>
                    </label>

                    <!-- UPI Instant Payment Option -->
                    <label class="flex items-center justify-between p-4 rounded-2xl border border-zinc-200 hover:border-zinc-400 cursor-pointer transition-all">
                        <div class="flex items-center gap-3">
                            <input type="radio" name="paymentMethod" value="UPI / QR Code" class="w-4 h-4 text-black focus:ring-0">
                            <div>
                                <p class="text-xs font-bold text-zinc-900">UPI / QR Code / NetBanking</p>
                                <p class="text-[11px] text-zinc-500">Google Pay, PhonePe, Paytm, or direct NetBanking</p>
                            </div>
                        </div>
                        <i class="ri-qr-code-line text-xl text-zinc-400"></i>
                    </label>

                    <!-- Card Option -->
                    <label class="flex items-center justify-between p-4 rounded-2xl border border-zinc-200 hover:border-zinc-400 cursor-pointer transition-all">
                        <div class="flex items-center gap-3">
                            <input type="radio" name="paymentMethod" value="Credit / Debit Card" class="w-4 h-4 text-black focus:ring-0">
                            <div>
                                <p class="text-xs font-bold text-zinc-900">Credit / Debit Card</p>
                                <p class="text-[11px] text-zinc-500">Visa, Mastercard, American Express, Rupay</p>
                            </div>
                        </div>
                        <i class="ri-bank-card-line text-xl text-zinc-400"></i>
                    </label>
                </div>
            </div>

        </div>

        <!-- Right Column: Order Items & Place Order Confirmation -->
        <div class="lg:col-span-5 space-y-6">
            
            <div class="bg-white rounded-3xl p-6 border border-zinc-200 shadow-xl space-y-5">
                <h3 class="text-sm font-bold text-zinc-900 uppercase tracking-wider border-b border-zinc-100 pb-3">
                    Items to Dispatch (<%= cartItems.reduce((acc, i) => acc + (i.quantity||1), 0) %>)
                </h3>

                <!-- Mini Items List -->
                <div class="space-y-3 max-h-60 overflow-y-auto pr-2 no-scrollbar">
                    <% cartItems.forEach(function(item) { %>
                        <% 
                           const p = item.product;
                           if(!p) return;
                           const unitPrice = Math.max(0, p.price - (p.discount || 0));
                           const bgBackdrop = p.bgcolor || '#f4f4f5';
                        %>
                        <div class="flex items-center justify-between gap-3 text-xs py-1">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl flex-shrink-0 flex items-center justify-center p-1 border border-zinc-200" style="background-color: <%= bgBackdrop %>;">
                                    <% if (p.image && p.image.length > 0) { %>
                                        <% 
                                           let isSvg = p.image.toString('utf8').trim().startsWith('<svg');
                                           let mime = isSvg ? 'image/svg+xml' : 'image/jpeg';
                                        %>
                                        <img class="max-h-10 max-w-full object-contain" src="data:<%= mime %>;base64,<%= p.image.toString('base64') %>" alt="">
                                    <% } %>
                                </div>
                                <div>
                                    <h4 class="font-bold text-zinc-900 line-clamp-1"><%= p.name %></h4>
                                    <span class="text-zinc-500 text-[11px]">Qty: <%= item.quantity || 1 %></span>
                                </div>
                            </div>
                            <span class="font-extrabold text-zinc-900 whitespace-nowrap">
                                ₹ <%= (unitPrice * (item.quantity || 1)).toLocaleString('en-IN') %>
                            </span>
                        </div>
                    <% }) %>
                </div>

                <!-- Price Calculations -->
                <div class="space-y-2 text-xs border-t border-zinc-100 pt-4">
                    <div class="flex justify-between text-zinc-600">
                        <span>Total MRP</span>
                        <span class="font-semibold text-zinc-900">₹ <%= totalMRP.toLocaleString('en-IN') %></span>
                    </div>
                    <div class="flex justify-between text-zinc-600">
                        <span>Catalog Savings</span>
                        <span class="font-semibold text-emerald-600">- ₹ <%= totalDiscount.toLocaleString('en-IN') %></span>
                    </div>
                    <% if (couponDiscount > 0) { %>
                        <div class="flex justify-between text-zinc-600">
                            <span>Privé Code (<%= coupon.code %>)</span>
                            <span class="font-semibold text-emerald-600">- ₹ <%= couponDiscount.toLocaleString('en-IN') %></span>
                        </div>
                    <% } %>
                    <div class="flex justify-between text-zinc-600">
                        <span>Delivery Charge</span>
                        <span class="font-semibold <%= shippingFee === 0 ? 'text-emerald-600' : 'text-zinc-900' %>">
                            <%= shippingFee === 0 ? 'FREE' : '₹ ' + shippingFee %>
                        </span>
                    </div>
                </div>

                <!-- Grand Total -->
                <div class="pt-4 border-t border-zinc-200 flex items-baseline justify-between">
                    <div>
                        <span class="text-xs uppercase font-extrabold text-zinc-500 block">Payable Total</span>
                        <span class="text-[10px] text-zinc-400">Net after all promotions</span>
                    </div>
                    <span class="text-2xl font-black text-zinc-900">
                        ₹ <%= netTotal.toLocaleString('en-IN') %>
                    </span>
                </div>

                <!-- Place Order Button -->
                <button 
                    type="submit" 
                    class="w-full bg-amber-500 hover:bg-amber-400 text-zinc-950 font-black text-xs py-4 rounded-2xl flex items-center justify-center gap-2 uppercase tracking-wider shadow-xl hover:shadow-2xl transition-all duration-200 cursor-pointer"
                >
                    <i class="ri-shield-check-fill text-base"></i>
                    <span>Confirm & Authorize Order</span>
                </button>

                <p class="text-center text-[10px] text-zinc-400">
                    By confirming, you agree to Scatch's atelier craftsmanship guarantee and terms of service.
                </p>

            </div>

        </div>

    </form>

</div>

<%- include('./partials/footer') %>
