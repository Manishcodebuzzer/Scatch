<%- include('./partials/header') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-zinc-200 shadow-xl text-center space-y-6">
        
        <!-- Success Icon -->
        <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-4xl shadow-inner">
            <i class="ri-checkbox-circle-fill"></i>
        </div>

        <div>
            <span class="text-xs font-bold uppercase tracking-widest text-amber-600">
                Craftsmanship Order Confirmed
            </span>
            <h1 class="luxury-serif text-3xl sm:text-4xl font-extrabold text-zinc-900 mt-1">
                Thank You for Your Patronage
            </h1>
            <p class="text-xs sm:text-sm text-zinc-500 mt-2 max-w-md mx-auto">
                Your order has been registered in our atelier ledger under reference 
                <strong class="text-zinc-900 font-bold">#<%= order.orderId %></strong>.
            </p>
        </div>

        <!-- Tracking Timeline Stepper -->
        <div class="py-6 border-t border-b border-zinc-200">
            <div class="flex items-center justify-between max-w-xl mx-auto text-xs relative">
                
                <!-- Step 1 -->
                <div class="flex flex-col items-center z-10 space-y-1">
                    <div class="w-8 h-8 rounded-full bg-zinc-950 text-white flex items-center justify-center font-bold text-xs shadow-md">
                        <i class="ri-check-line"></i>
                    </div>
                    <span class="font-bold text-zinc-900">Confirmed</span>
                </div>

                <!-- Step 2 -->
                <div class="flex flex-col items-center z-10 space-y-1">
                    <div class="w-8 h-8 rounded-full bg-amber-400 text-zinc-950 flex items-center justify-center font-bold text-xs shadow-md">
                        <i class="ri-scissors-2-line"></i>
                    </div>
                    <span class="font-bold text-zinc-800">Atelier Prep</span>
                </div>

                <!-- Step 3 -->
                <div class="flex flex-col items-center z-10 space-y-1">
                    <div class="w-8 h-8 rounded-full bg-zinc-200 text-zinc-500 flex items-center justify-center font-bold text-xs">
                        <i class="ri-truck-line"></i>
                    </div>
                    <span class="text-zinc-400">Dispatch</span>
                </div>

                <!-- Step 4 -->
                <div class="flex flex-col items-center z-10 space-y-1">
                    <div class="w-8 h-8 rounded-full bg-zinc-200 text-zinc-500 flex items-center justify-center font-bold text-xs">
                        <i class="ri-home-5-line"></i>
                    </div>
                    <span class="text-zinc-400">Delivered</span>
                </div>

                <!-- Background Connector Line -->
                <div class="absolute left-8 right-8 top-4 h-0.5 bg-zinc-200 -z-0"></div>
                <div class="absolute left-8 w-1/3 top-4 h-0.5 bg-zinc-950 -z-0"></div>
            </div>
        </div>

        <!-- Order Details Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left pt-2">
            
            <!-- Shipping Destination -->
            <div class="p-5 rounded-2xl bg-zinc-50 border border-zinc-200 space-y-2 text-xs">
                <h3 class="font-bold text-zinc-900 uppercase tracking-wider flex items-center gap-1.5">
                    <i class="ri-map-pin-line text-amber-600"></i> Dispatch Destination
                </h3>
                <p class="font-bold text-zinc-800"><%= order.shippingAddress.fullname %></p>
                <p class="text-zinc-600"><%= order.shippingAddress.street %></p>
                <p class="text-zinc-600"><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %></p>
                <p class="text-zinc-600">Phone: <%= order.shippingAddress.phone %></p>
            </div>

            <!-- Payment Details -->
            <div class="p-5 rounded-2xl bg-zinc-50 border border-zinc-200 space-y-2 text-xs">
                <h3 class="font-bold text-zinc-900 uppercase tracking-wider flex items-center gap-1.5">
                    <i class="ri-bank-card-line text-amber-600"></i> Settlement Details
                </h3>
                <div class="flex justify-between py-0.5">
                    <span class="text-zinc-500">Payment Mode</span>
                    <span class="font-bold text-zinc-900"><%= order.paymentMethod %></span>
                </div>
                <div class="flex justify-between py-0.5">
                    <span class="text-zinc-500">Payment Status</span>
                    <span class="font-bold text-emerald-600"><%= order.paymentStatus || 'Confirmed' %></span>
                </div>
                <div class="flex justify-between py-0.5">
                    <span class="text-zinc-500">Amount Paid / Due</span>
                    <span class="font-black text-sm text-zinc-900">₹ <%= order.totalAmount.toLocaleString('en-IN') %></span>
                </div>
            </div>

        </div>

        <!-- Items Ordered -->
        <div class="text-left pt-4 space-y-3">
            <h3 class="font-bold text-xs uppercase tracking-wider text-zinc-900">Bespoke Pieces in this Shipment</h3>
            <div class="border border-zinc-200 rounded-2xl divide-y divide-zinc-100 overflow-hidden">
                <% order.items.forEach(function(item) { %>
                    <div class="p-4 flex items-center justify-between gap-4 text-xs bg-white">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg flex items-center justify-center font-bold text-white text-xs" style="background-color: <%= item.panelcolor || '#18181b' %>;">
                                <i class="ri-handbag-line"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-zinc-900"><%= item.name %></h4>
                                <span class="text-zinc-500 text-[11px]">Qty: <%= item.quantity %> &bull; Unit: ₹<%= (item.price - (item.discount||0)).toLocaleString('en-IN') %></span>
                            </div>
                        </div>
                        <span class="font-black text-zinc-900">
                            ₹ <%= ((item.price - (item.discount||0)) * item.quantity).toLocaleString('en-IN') %>
                        </span>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
            <a href="/my-orders" class="w-full sm:w-auto px-8 py-3.5 bg-zinc-950 hover:bg-zinc-800 text-white font-bold text-xs uppercase tracking-wider rounded-2xl shadow-lg transition-all">
                View in My Orders
            </a>
            <a href="/shop" class="w-full sm:w-auto px-8 py-3.5 bg-zinc-100 hover:bg-zinc-200 text-zinc-900 font-bold text-xs uppercase tracking-wider rounded-2xl transition-all">
                Continue Exploring
            </a>
        </div>

    </div>

</div>

<%- include('./partials/footer') %>
