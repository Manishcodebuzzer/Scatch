<%- include('./partials/header') %>

<div class="min-h-[calc(100vh-80px)] flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-zinc-50 via-white to-zinc-100">
    <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Hero Section -->
        <div class="lg:col-span-7 space-y-8 pr-0 lg:pr-8">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900 text-amber-300 text-xs font-semibold tracking-wider uppercase shadow-sm">
                <i class="ri-sparkling-fill text-amber-400"></i>
                <span>Autumn / Winter 2026 Collection</span>
            </div>

            <div class="space-y-4">
                <h1 class="luxury-serif text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-zinc-900 leading-[1.1]">
                    Timeless Leathercraft, <br>
                    <span class="italic font-normal text-zinc-600">Forged for the Journey.</span>
                </h1>
                <p class="text-base sm:text-lg text-zinc-600 max-w-xl font-normal leading-relaxed">
                    Scatch curates artisanal leather bags crafted from full-grain Tuscan hides. Minimalist architectural silhouettes designed to endure generations of travel.
                </p>
            </div>

            <!-- Value Props -->
            <div class="grid grid-cols-3 gap-4 pt-2 border-t border-zinc-200">
                <div class="space-y-1">
                    <p class="text-sm font-bold text-zinc-900 flex items-center gap-1.5">
                        <i class="ri-medal-line text-amber-600"></i>
                        Full-Grain Leather
                    </p>
                    <p class="text-xs text-zinc-500">Certified vegetable-tanned hides</p>
                </div>
                <div class="space-y-1">
                    <p class="text-sm font-bold text-zinc-900 flex items-center gap-1.5">
                        <i class="ri-fingerprint-line text-amber-600"></i>
                        Artisanal Stitching
                    </p>
                    <p class="text-xs text-zinc-500">Hand-burnished waxed threads</p>
                </div>
                <div class="space-y-1">
                    <p class="text-sm font-bold text-zinc-900 flex items-center gap-1.5">
                        <i class="ri-shield-star-line text-amber-600"></i>
                        Lifetime Warranty
                    </p>
                    <p class="text-xs text-zinc-500">Complimentary hardware care</p>
                </div>
            </div>

            <!-- Featured Showcase Mini Banner -->
            <div class="bg-zinc-900 rounded-3xl p-6 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl relative overflow-hidden">
                <div class="space-y-2 z-10">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-amber-400">Curated Preview</span>
                    <h3 class="text-xl font-bold">Discover our Signature Totes & Travel Bags</h3>
                    <p class="text-xs text-zinc-400 max-w-sm">Shop instantly without creating an account or login below for personalized curation.</p>
                </div>
                <a href="/shop" class="z-10 whitespace-nowrap px-6 py-3 bg-amber-400 hover:bg-amber-300 text-zinc-950 text-xs font-bold uppercase tracking-wider rounded-full shadow-lg transition-all duration-200 hover:scale-105">
                    Explore Shop &rarr;
                </a>
                <div class="absolute -right-8 -bottom-8 w-48 h-48 bg-amber-500/10 rounded-full blur-2xl"></div>
            </div>
        </div>

        <!-- Right Side: Dual Auth Card (Register & Sign In) -->
        <div class="lg:col-span-5">
            <div class="bg-white rounded-3xl shadow-2xl border border-zinc-200/80 p-8 sm:p-10 relative">
                
                <!-- Tab Switching Header -->
                <div class="flex items-center justify-between border-b border-zinc-200 pb-4 mb-6">
                    <button id="tab-login-btn" onclick="showAuthTab('login')" class="text-sm font-bold text-zinc-900 pb-2 border-b-2 border-zinc-900 transition-colors">
                        Sign In
                    </button>
                    <button id="tab-register-btn" onclick="showAuthTab('register')" class="text-sm font-semibold text-zinc-400 hover:text-zinc-700 pb-2 border-b-2 border-transparent transition-colors">
                        Create Account
                    </button>
                </div>

                <!-- Sign In Form -->
                <div id="auth-login" class="space-y-5">
                    <div>
                        <h2 class="text-xl font-bold text-zinc-900">Welcome Back</h2>
                        <p class="text-xs text-zinc-500 mt-1">Access your saved orders, wishlist, and bespoke atelier services.</p>
                    </div>

                    <form action="/users/login" method="POST" autocomplete="on" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 mb-1">Email Address</label>
                            <div class="relative">
                                <input 
                                    type="email" 
                                    name="email" 
                                    required 
                                    placeholder="e.g. alex@example.com"
                                    class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 focus:bg-white rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all placeholder:text-zinc-400"
                                >
                                <i class="ri-mail-line absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
                            </div>
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="block text-xs font-semibold text-zinc-700">Password</label>
                                <span class="text-[11px] text-zinc-400">At least 6 characters</span>
                            </div>
                            <div class="relative">
                                <input 
                                    type="password" 
                                    name="password" 
                                    required 
                                    placeholder="••••••••"
                                    class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 focus:bg-white rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all placeholder:text-zinc-400"
                                >
                                <i class="ri-lock-line absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
                            </div>
                        </div>

                        <button 
                            type="submit" 
                            class="w-full bg-zinc-900 hover:bg-zinc-800 text-white font-bold text-xs py-3.5 rounded-xl uppercase tracking-wider shadow-lg hover:shadow-xl transition-all duration-200 mt-2"
                        >
                            Sign In to Account
                        </button>
                    </form>

                    <div class="pt-3 text-center">
                        <button onclick="showAuthTab('register')" class="text-xs text-zinc-600 hover:text-zinc-900 font-medium">
                            Don't have an account? <span class="font-bold underline">Create one now</span>
                        </button>
                    </div>
                </div>

                <!-- Register Form (Hidden by default) -->
                <div id="auth-register" class="space-y-5 hidden">
                    <div>
                        <h2 class="text-xl font-bold text-zinc-900">Create an Account</h2>
                        <p class="text-xs text-zinc-500 mt-1">Unlock exclusive member privileges and complimentary express delivery.</p>
                    </div>

                    <form action="/users/register" method="POST" autocomplete="off" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 mb-1">Full Name</label>
                            <div class="relative">
                                <input 
                                    type="text" 
                                    name="fullname" 
                                    required 
                                    placeholder="e.g. Leonardo Da Vinci"
                                    class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 focus:bg-white rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all placeholder:text-zinc-400"
                                >
                                <i class="ri-user-line absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 mb-1">Email Address</label>
                            <div class="relative">
                                <input 
                                    type="email" 
                                    name="email" 
                                    required 
                                    placeholder="e.g. leonardo@florence.com"
                                    class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 focus:bg-white rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all placeholder:text-zinc-400"
                                >
                                <i class="ri-mail-line absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 mb-1">Choose Password</label>
                            <div class="relative">
                                <input 
                                    type="password" 
                                    name="password" 
                                    required 
                                    placeholder="Create a secure password"
                                    class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 focus:bg-white rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all placeholder:text-zinc-400"
                                >
                                <i class="ri-lock-2-line absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
                            </div>
                        </div>

                        <button 
                            type="submit" 
                            class="w-full bg-amber-500 hover:bg-amber-400 text-zinc-950 font-extrabold text-xs py-3.5 rounded-xl uppercase tracking-wider shadow-lg hover:shadow-xl transition-all duration-200 mt-2"
                        >
                            Complete Registration
                        </button>
                    </form>

                    <div class="pt-3 text-center">
                        <button onclick="showAuthTab('login')" class="text-xs text-zinc-600 hover:text-zinc-900 font-medium">
                            Already registered? <span class="font-bold underline">Sign in instead</span>
                        </button>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<script>
    function showAuthTab(tab) {
        const loginEl = document.getElementById('auth-login');
        const regEl = document.getElementById('auth-register');
        const loginBtn = document.getElementById('tab-login-btn');
        const regBtn = document.getElementById('tab-register-btn');

        if (tab === 'register') {
            loginEl.classList.add('hidden');
            regEl.classList.remove('hidden');
            loginBtn.className = "text-sm font-semibold text-zinc-400 hover:text-zinc-700 pb-2 border-b-2 border-transparent transition-colors";
            regBtn.className = "text-sm font-bold text-zinc-900 pb-2 border-b-2 border-zinc-900 transition-colors";
        } else {
            regEl.classList.add('hidden');
            loginEl.classList.remove('hidden');
            regBtn.className = "text-sm font-semibold text-zinc-400 hover:text-zinc-700 pb-2 border-b-2 border-transparent transition-colors";
            loginBtn.className = "text-sm font-bold text-zinc-900 pb-2 border-b-2 border-zinc-900 transition-colors";
        }
    }
</script>

<%- include('./partials/footer') %>