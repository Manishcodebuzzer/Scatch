<%- include('./partials/header') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <div class="flex items-center justify-between pb-6 border-b border-zinc-200 mb-8">
        <div>
            <span class="text-xs font-bold uppercase tracking-widest text-amber-600 block mb-1">
                Atelier Client History
            </span>
            <h1 class="luxury-serif text-3xl font-extrabold text-zinc-900 tracking-tight">
                My Orders & Deliveries
            </h1>
        </div>
        <a href="/shop" class="text-xs font-bold text-zinc-600 hover:text-black flex items-center gap-1">
            <i class="ri-arrow-left-line"></i> Back to Catalog
        </a>
    </div>

    <% if (orders && orders.length > 0) { %>
        <div class="space-y-8">
            <% orders.forEach(function(order) { %>
                <div class="bg-white rounded-3xl border border-zinc-200 shadow-md overflow-hidden">
                    
                    <!-- Order Top Header Bar -->
                    <div class="p-6 bg-zinc-50 border-b border-zinc-200 flex flex-wrap items-center justify-between gap-4 text-xs">
                        <div class="space-y-1">
                            <span class="text-zinc-400 uppercase tracking-wider text-[10px] font-bold">Order ID</span>
                            <p class="font-extrabold text-zinc-900 text-sm">#<%= order.orderId %></p>
                        </div>

                        <div class="space-y-1">
                            <span class="text-zinc-400 uppercase tracking-wider text-[10px] font-bold">Placed On</span>
                            <p class="font-semibold text-zinc-800">
                                <%= new Date(order.createdAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            </p>
                        </div>

                        <div class="space-y-1">
                            <span class="text-zinc-400 uppercase tracking-wider text-[10px] font-bold">Settlement</span>
                            <p class="font-bold text-zinc-900">
                                ₹ <%= (order.totalAmount || 0).toLocaleString('en-IN') %> (<%= order.paymentMethod %>)
                            </p>
                        </div>

                        <div>
                            <% 
                               let statusBg = 'bg-zinc-900 text-white';
                               if (order.status === 'Processing') statusBg = 'bg-amber-100 text-amber-900 border border-amber-300';
                               if (order.status === 'Shipped') statusBg = 'bg-blue-100 text-blue-900 border border-blue-300';
                               if (order.status === 'Delivered') statusBg = 'bg-emerald-100 text-emerald-900 border border-emerald-300';
                               if (order.status === 'Cancelled') statusBg = 'bg-red-100 text-red-900 border border-red-300';
                            %>
                            <span class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider shadow-sm <%= statusBg %>">
                                <%= order.status || 'Confirmed' %>
                            </span>
                        </div>
                    </div>

                    <!-- Items List -->
                    <div class="p-6 divide-y divide-zinc-100">
                        <% order.items.forEach(function(item) { %>
                            <div class="py-4 first:pt-0 last:pb-0 flex items-center justify-between gap-4 text-xs">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-xl flex items-center justify-center text-white text-base font-bold shadow-sm" style="background-color: <%= item.panelcolor || '#18181b' %>;">
                                        <i class="ri-handbag-line"></i>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-zinc-900 text-sm"><%= item.name %></h4>
                                        <p class="text-zinc-500 text-[11px]">Quantity: <%= item.quantity %> &bull; Unit: ₹<%= (item.price - (item.discount||0)).toLocaleString('en-IN') %></p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <span class="font-black text-sm text-zinc-900">
                                        ₹ <%= ((item.price - (item.discount||0)) * item.quantity).toLocaleString('en-IN') %>
                                    </span>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <!-- Delivery Destination Footer -->
                    <div class="px-6 py-4 bg-zinc-50/60 border-t border-zinc-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-zinc-500">
                        <div>
                            <span class="font-bold text-zinc-700">Dispatched To:</span>
                            <span><%= order.shippingAddress.fullname %>, <%= order.shippingAddress.street %>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %></span>
                        </div>
                        <span class="font-bold text-amber-700 flex items-center gap-1">
                            <i class="ri-shield-check-line"></i> Lifetime Atelier Care Active
                        </span>
                    </div>

                </div>
            <% }) %>
        </div>
    <% } else { %>
        <!-- Empty Orders State -->
        <div class="py-24 text-center max-w-md mx-auto">
            <div class="w-24 h-24 bg-zinc-100 rounded-full flex items-center justify-center mx-auto text-zinc-400 mb-6">
                <i class="ri-archive-line text-5xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-zinc-900 mb-2">No Past Orders Found</h2>
            <p class="text-xs sm:text-sm text-zinc-500 mb-8 leading-relaxed">
                You have not placed any orders yet. Discover our artisanal bag collection and place your first order today.
            </p>
            <a href="/shop" class="inline-flex items-center gap-2 px-8 py-3.5 bg-zinc-950 hover:bg-zinc-800 text-white text-xs font-bold uppercase tracking-wider rounded-full shadow-lg transition-all">
                <span>Start Exploring</span>
                <i class="ri-arrow-right-line"></i>
            </a>
        </div>
    <% } %>

</div>

<%- include('./partials/footer') %>
