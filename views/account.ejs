<%- include('./partials/header') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <div class="pb-6 border-b border-zinc-200 mb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-600 block mb-1">
            Atelier Membership
        </span>
        <h1 class="luxury-serif text-3xl font-extrabold text-zinc-900 tracking-tight">
            Account & Preferences
        </h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left Column: Member Card & Quick Shortcuts -->
        <div class="lg:col-span-4 space-y-6">
            
            <!-- Member ID Card -->
            <div class="bg-zinc-950 text-white rounded-3xl p-6 shadow-xl relative overflow-hidden space-y-5">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-amber-400 text-zinc-950 flex items-center justify-center text-xl font-black uppercase shadow-lg">
                        <%= user.fullname ? user.fullname.charAt(0) : 'U' %>
                    </div>
                    <div>
                        <h3 class="font-extrabold text-base tracking-tight"><%= user.fullname %></h3>
                        <p class="text-xs text-zinc-400 truncate max-w-[170px]"><%= user.email %></p>
                        <span class="inline-block mt-1 text-[10px] font-bold text-amber-400 uppercase tracking-wider bg-zinc-900 px-2 py-0.5 rounded-full border border-zinc-800">
                            Privé Client
                        </span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 pt-3 border-t border-zinc-800/80 text-xs">
                    <div class="space-y-0.5">
                        <span class="text-zinc-500 text-[10px] uppercase font-bold">Total Orders</span>
                        <p class="text-base font-extrabold text-white"><%= user.orders ? user.orders.length : 0 %></p>
                    </div>
                    <div class="space-y-0.5">
                        <span class="text-zinc-500 text-[10px] uppercase font-bold">Saved Items</span>
                        <p class="text-base font-extrabold text-white"><%= user.wishlist ? user.wishlist.length : 0 %></p>
                    </div>
                </div>

                <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-amber-500/10 rounded-full blur-xl pointer-events-none"></div>
            </div>

            <!-- Quick Navigation Menu -->
            <div class="bg-white rounded-3xl border border-zinc-200 shadow-sm p-4 space-y-1 text-xs font-semibold">
                <a href="/my-orders" class="flex items-center justify-between p-3 rounded-2xl hover:bg-zinc-50 text-zinc-800 transition-colors">
                    <span class="flex items-center gap-3">
                        <i class="ri-archive-line text-amber-600 text-base"></i> My Orders & Deliveries
                    </span>
                    <i class="ri-arrow-right-s-line text-zinc-400"></i>
                </a>
                <a href="/wishlist" class="flex items-center justify-between p-3 rounded-2xl hover:bg-zinc-50 text-zinc-800 transition-colors">
                    <span class="flex items-center gap-3">
                        <i class="ri-heart-line text-amber-600 text-base"></i> Saved Wishlist
                    </span>
                    <i class="ri-arrow-right-s-line text-zinc-400"></i>
                </a>
                <a href="/cart" class="flex items-center justify-between p-3 rounded-2xl hover:bg-zinc-50 text-zinc-800 transition-colors">
                    <span class="flex items-center gap-3">
                        <i class="ri-shopping-bag-line text-amber-600 text-base"></i> Shopping Bag
                    </span>
                    <i class="ri-arrow-right-s-line text-zinc-400"></i>
                </a>
                <% if (typeof isOwner !== 'undefined' && isOwner) { %>
                    <a href="/owners/admin" class="flex items-center justify-between p-3 rounded-2xl bg-amber-50 text-amber-900 transition-colors">
                        <span class="flex items-center gap-3">
                            <i class="ri-dashboard-3-line text-amber-600 text-base"></i> Admin Control Panel
                        </span>
                        <i class="ri-arrow-right-s-line text-amber-600"></i>
                    </a>
                <% } %>
                <a href="/logout" class="flex items-center justify-between p-3 rounded-2xl hover:bg-red-50 text-red-600 transition-colors">
                    <span class="flex items-center gap-3">
                        <i class="ri-logout-box-r-line text-red-500 text-base"></i> Sign Out
                    </span>
                    <i class="ri-arrow-right-s-line text-red-400"></i>
                </a>
            </div>

        </div>

        <!-- Right Column: Edit Profile & Address Form -->
        <div class="lg:col-span-8 bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200 shadow-sm space-y-6">
            <div class="border-b border-zinc-100 pb-3">
                <h2 class="text-base font-bold text-zinc-900">Personal Atelier Profile & Default Address</h2>
                <p class="text-xs text-zinc-500 mt-0.5">Keep your dispatch destinations and contact channels up to date.</p>
            </div>

            <form action="/users/profile" method="POST" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-700 mb-1">Full Name</label>
                        <input 
                            type="text" 
                            name="fullname" 
                            required 
                            value="<%= user.fullname || '' %>"
                            class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                        >
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-700 mb-1">Contact Phone</label>
                        <input 
                            type="tel" 
                            name="contact" 
                            placeholder="+91 98765 43210"
                            value="<%= user.contact || '' %>"
                            class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                        >
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-zinc-700 mb-1">Registered Email Address (Read-only)</label>
                        <input 
                            type="email" 
                            disabled 
                            value="<%= user.email %>"
                            class="w-full bg-zinc-100 border border-zinc-200 rounded-xl px-4 py-3 text-xs text-zinc-500 cursor-not-allowed"
                        >
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-zinc-700 mb-1">Default Street Address</label>
                        <input 
                            type="text" 
                            name="street" 
                            placeholder="e.g. 42 Luxury Estate, Park Avenue"
                            value="<%= user.address && user.address.street ? user.address.street : '' %>"
                            class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                        >
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-zinc-700 mb-1">City</label>
                        <input 
                            type="text" 
                            name="city" 
                            placeholder="e.g. New Delhi"
                            value="<%= user.address && user.address.city ? user.address.city : '' %>"
                            class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                        >
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 mb-1">State</label>
                            <input 
                                type="text" 
                                name="state" 
                                placeholder="Delhi"
                                value="<%= user.address && user.address.state ? user.address.state : '' %>"
                                class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                            >
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-zinc-700 mb-1">Postal Pincode</label>
                            <input 
                                type="text" 
                                name="pincode" 
                                placeholder="110001"
                                value="<%= user.address && user.address.pincode ? user.address.pincode : '' %>"
                                class="w-full bg-zinc-50 border border-zinc-300 focus:border-zinc-900 rounded-xl px-4 py-3 text-xs text-zinc-900 focus:outline-none transition-all"
                            >
                        </div>
                    </div>
                </div>

                <div class="pt-4">
                    <button 
                        type="submit" 
                        class="px-8 py-3.5 bg-zinc-950 hover:bg-zinc-800 text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg transition-all"
                    >
                        Save Profile Updates
                    </button>
                </div>
            </form>
        </div>

    </div>

</div>

<%- include('./partials/footer') %>
